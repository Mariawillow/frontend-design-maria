---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
  ul {
    /* fylder hele vejen hen */
    grid-column: 1 /-1;
    display: flex;
    /* Overflot-x sørger for at vi kan scroll kun på det given område, her på x-aksen */
    overflow-x: auto;
    list-style: none;
    padding-inline: max(20px, 50% - var(--content-width) / 2);
    scroll-padding-inline-start: (20px, 50% - var(--content-width) / 2);
    scroll-snap-type: inline mandatory;

    gap: var(--card-gap);

    li {
      flex-basis: min(50%, 300%);
      flex-shrink: 0;
      scroll-snap-align: center;

      background-color: var(--card-background);
      padding: var(--card-padding);
      color: var(--card-text-color);
      border-radius: var(--card-border-radius);
    }
  }
</style>
